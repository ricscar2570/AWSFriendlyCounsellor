import { esc, formatDate, num } from './utils.js';

const regions=['eu-central-1','eu-west-1','eu-west-2','eu-west-3','eu-north-1','eu-central-2','eu-south-1','eu-south-2','us-east-1','us-east-2','us-west-1','us-west-2','ap-southeast-1','ap-southeast-2','ap-northeast-1'];
const regionOptions=(sel='eu-central-1')=>regions.map(r=>`<option ${r===sel?'selected':''}>${r}</option>`).join('');
const budgetOptions=(sel='medium')=>['low','medium','high'].map(x=>`<option value="${x}" ${x===sel?'selected':''}>${x[0].toUpperCase()+x.slice(1)}</option>`).join('');
const pill=(value,kind=value)=>`<span class="pill ${esc(kind)}">${esc(value)}</span>`;

export function landing(settings){
  return `<main class="landing"><div class="landing-grid"><section class="hero">
    <div class="brand big"><span class="logo">☁</span><span>AWS Friendly Counsellor</span></div>
    <h1>Design AWS with confidence,<br><span>without starting as a cloud architect.</span></h1>
    <p class="lead">Guided architecture, cost ranges, service rationale, implementation steps, immutable project history, audit and Terraform baselines — in one web application.</p>
    <div class="hero-actions">${settings.authMode==='cognito'?'<button class="btn primary" data-action="login">Sign in with Cognito</button>':'<a class="btn primary" href="#/dashboard">Open application</a>'}<a class="btn ghost" href="#/settings">Connection settings</a></div>
    <div class="trust-row"><span>✓ No secrets in GitHub Pages</span><span>✓ No backend required</span><span>✓ Data stays in your browser</span><span>✓ AWS connector is optional</span></div>
  </section><aside class="hero-card"><div class="terminal-head"><span></span><span></span><span></span></div><div class="mock-card">
    <div class="eyebrow">Architecture result</div><h3>Serverless customer portal</h3>
    <div class="flow"><span>CloudFront</span><b>→</b><span>API Gateway</span><b>→</b><span>Lambda</span><b>→</b><span>DynamoDB</span></div>
    <div class="metric-grid"><div><strong>$84–$214</strong><small>monthly range</small></div><div><strong>8</strong><small>AWS services</small></div><div><strong>High</strong><small>resilience target</small></div></div>
    <div class="status good">Security baseline included</div></div></aside></div></main>`;
}

export function shell({route,settings,identity,body,health}){
  const nav=[['/dashboard','⌂','Dashboard'],['/advisor','✦','Friendly Advisor'],['/projects','▦','Projects'],['/finops','◫','FinOps'],['/team','♟','Team'],['/audit','≡','Audit'],['/privacy','⌁','Privacy'],['/data','⇩','Data & Backup'],['/settings','⚙','Settings']];
  const links=nav.map(([p,i,l])=>`<a href="#${p}" class="${route===p||route.startsWith(p+'/')?'active':''}"><span>${i}</span>${l}</a>`).join('');
  return `<div class="app-shell"><aside class="sidebar"><a class="brand" href="#/dashboard"><span class="logo">☁</span><span>AWS Friendly<br><strong>Counsellor</strong></span></a><nav>${links}</nav><div class="side-bottom"><div class="mode-card"><span class="dot ${esc(settings.authMode)}"></span><div><strong>${esc(settings.authMode.toUpperCase())}</strong><small>${settings.authMode==='standalone'?'Local-first · no backend':settings.authMode==='demo'?'Browser simulation':esc(settings.apiBaseUrl||'API not configured')}</small></div></div><a href="#/about" class="tiny-link">Release & limits</a></div></aside><section class="workspace"><header class="topbar"><button class="mobile-menu" data-action="toggle-menu" aria-label="Menu">☰</button><div><strong>${identity?.username?esc(identity.username):'AWS Friendly Counsellor'}</strong><small>${identity?.subject?esc(identity.subject):'Not connected'}</small></div><div class="top-actions"><span class="health ${health?.status==='healthy'?'ok':'warn'}">${health?.status==='healthy'?'● Ready':'● Runtime unavailable'}</span>${settings.authMode==='standalone'?'<button class="btn mini ghost" data-action="install-app">Install app</button>':''}${settings.authMode==='cognito'?'<button class="btn mini ghost" data-action="logout">Sign out</button>':''}</div></header><main class="content">${body}</main></section></div>`;
}

export function onboarding(settings){
  return `<section class="page narrow"><div class="eyebrow">First run</div><h1>Create or open a workspace</h1><p class="muted">In Standalone mode the workspace is stored locally in this browser. You can export and restore it as a portable backup.</p><div class="two-col"><form class="panel" id="create-tenant-form"><h2>Create workspace</h2><label>Workspace name<input name="name" required minlength="2" maxlength="120" placeholder="Acme Cloud Team"></label><label>Slug <small>optional</small><input name="slug" pattern="[a-z0-9]+(?:-[a-z0-9]+)*" placeholder="acme-cloud-team"></label><button class="btn primary" type="submit">Create workspace</button></form><form class="panel" id="connect-tenant-form"><h2>Existing workspace</h2><label>Tenant ID<input name="tenantId" required placeholder="tenant_…"></label><button class="btn" type="submit">Connect</button><p class="hint">Standalone mode opens only workspaces present in the local vault; connector modes keep server-side authorization.</p></form></div><div class="form-actions"><a class="btn ghost" href="#/data">Restore a full backup</a></div><p class="hint">Mode: <strong>${esc(settings.authMode)}</strong>. ${settings.authMode==='standalone'?'No network connection is required.':settings.authMode==='demo'?'This creates browser-local demo data.':'Your configured connector API must be reachable and CORS must allow this site origin.'}</p></section>`;
}

function projectRow(p){return `<a class="project-row" href="#/project/${encodeURIComponent(p.id)}"><div><strong>${esc(p.name)}</strong><small>${esc(p.region)} · ${num(p.estimated_users)} users</small></div>${pill(p.status,p.status)}</a>`;}

export function dashboard({tenant,projects=[],projectsHasMore=false,health,identity,latest,gamification=null,backupStatus=null,storageInfo=null,pricingStatus=null}){
  const badgeSection=gamification?.badges?.length?`<section class="panel badge-panel"><div class="panel-head"><div><div class="eyebrow">Progress</div><h2>Earned badges</h2></div><a href="#/finops">Open FinOps</a></div><div class="badge-row">${gamification.badges.map(b=>`<div class="badge earned"><strong>${esc(b.name)}</strong><small>${esc(b.description)}</small></div>`).join('')}</div></section>`:'';
  const backupTone=backupStatus?.critical?'danger':backupStatus?.recommended?'draft':'active';
  const backupText=backupStatus?.last_backup_at?`${backupStatus.age_days} day(s) ago`:'Never exported';
  const freshness=pricingStatus?.freshness_state||'unknown';
  const safety=`<section class="panel"><div class="panel-head"><div><div class="eyebrow">Local data safety</div><h2>Standalone health</h2></div><a href="#/data">Manage data</a></div><div class="facts"><div><dt>Backup</dt><dd>${pill(backupText,backupTone)}</dd></div><div><dt>Storage protection</dt><dd>${storageInfo?.persisted===true?'Persistent':storageInfo?.persisted===false?'Best effort':'Unknown'}</dd></div><div><dt>Pricing snapshot</dt><dd>${pill(freshness,freshness==='fresh'?'active':freshness==='aging'?'draft':'archived')}</dd></div><div><dt>Network required</dt><dd>${health?.network_required===false?'No':'Connector only'}</dd></div></div>${backupStatus?.recommended?'<p class="warning">A portable backup is recommended. Browser storage can be cleared by the user or operating system.</p>':''}</section>`;
  return `<section class="page"><div class="page-head"><div><div class="eyebrow">${tenant?esc(tenant.name):'Workspace'}</div><h1>Good to see you${identity?.username?', '+esc(identity.username.split(' ')[0]):''}.</h1><p class="muted">Describe a workload, review an explainable architecture, estimate cost and keep the project locally.</p></div><a class="btn primary" href="#/advisor">✦ Start guided analysis</a></div><div class="stat-grid"><div class="stat"><small>Projects loaded</small><strong>${projects.length}${projectsHasMore?'+':''}</strong><span>${projects.filter(p=>p.status==='active').length} active in this page</span></div><div class="stat"><small>Runtime</small><strong>${health?.status==='healthy'?'Ready':'Unknown'}</strong><span>${esc(health?.environment||'not checked')}</span></div><div class="stat"><small>Persistence</small><strong>${esc(health?.persistence_backend||'—')}</strong><span>${esc(health?.persistence_status||'')}</span></div><div class="stat"><small>Recent analysis sample</small><strong>${esc(latest?.typical_monthly_cost||'—')}</strong><span>${latest?`v${latest.version} · ${formatDate(latest.created_at)}`:'No history in visible projects'}</span></div></div>${safety}${badgeSection}<div class="dash-grid"><section class="panel"><div class="panel-head"><h2>Projects</h2><a href="#/projects">View all</a></div>${projects.length?`<div class="project-list">${projects.slice(0,5).map(projectRow).join('')}</div>`:'<div class="empty"><div class="empty-icon">▦</div><h3>No projects yet</h3><p>Create one or use the Friendly Advisor first.</p><a class="btn" href="#/advisor">Start with Advisor</a></div>'}</section><section class="panel"><h2>Recommended first run</h2><ol class="steps"><li><span>1</span><div><strong>Describe the workload</strong><small>Include users, data, latency, availability and compliance signals.</small></div></li><li><span>2</span><div><strong>Review risks and pillars</strong><small>Every recommendation is tied to explainable workload signals.</small></div></li><li><span>3</span><div><strong>Save a project</strong><small>Immutable analysis versions make changes traceable.</small></div></li><li><span>4</span><div><strong>Export a backup</strong><small>Keep a portable copy outside browser storage.</small></div></li></ol></section></div></section>`;
}

export function advisor(initial={}){
  return `<section class="page"><div class="page-head"><div><div class="eyebrow">Guided planning</div><h1>Friendly Advisor</h1><p class="muted">Describe the workload in ordinary language. The planner stays deterministic and versioned.</p></div>${pill('Contract 1.13.0','info')}</div><form id="advisor-form" class="wizard panel"><div class="wizard-step"><span>1</span><div><h3>What are you building?</h3><label>Product, data and important behaviors<textarea name="description" minlength="10" maxlength="5000" required placeholder="A customer portal with login, file uploads, analytics, webhooks and background reports…">${esc(initial.description||'')}</textarea></label><div class="chips"><button type="button" data-template="SaaS">SaaS</button><button type="button" data-template="E-commerce">E-commerce</button><button type="button" data-template="API">API</button><button type="button" data-template="Data">Data platform</button><button type="button" data-template="ML">ML inference</button></div></div></div><div class="wizard-step"><span>2</span><div><h3>Scale & constraints</h3><div class="form-grid"><label>Monthly active users<input type="number" name="estimated_users" min="1" max="100000000" value="${initial.estimated_users||5000}" required></label><label>Budget profile<select name="budget">${budgetOptions(initial.budget||'medium')}</select></label><label>AWS region<select name="region">${regionOptions(initial.region||'eu-central-1')}</select></label><label class="check"><input type="checkbox" name="advanced_guide" ${initial.advanced_guide===false?'':'checked'}><span>Include advanced operations guide</span></label></div></div></div><div class="wizard-actions"><button class="btn primary large" type="submit">Analyze architecture →</button><span class="hint">Transparent deterministic recommendations, not a probabilistic cost forecast.</span></div></form><div id="advisor-result"></div></section>`;
}

export function analysisResult(result,{showPersist=true}={}){
  if(!result)return '';
  const a=result.analysis,c=result.cost_analysis,g=result.implementation_guide;
  const services=(result.services||[]).map(s=>{const market=String((result.marketplace_links||{})[s.id]||'');const marketLink=market.startsWith('https://aws.amazon.com/marketplace/')?`<a class="hint" href="${esc(market)}" target="_blank" rel="noopener noreferrer">AWS Marketplace ↗</a>`:'';return `<article class="service"><div class="service-icon">AWS</div><div><strong>${esc(s.name)}</strong><small>${esc(s.category)}</small><p>${esc(s.why_needed)}</p>${marketLink}</div><span class="price">${esc(s.typical_monthly)}</span></article>`}).join('');
  const phases=(g?.phases||[]).map((p,i)=>`<article><span>${i+1}</span><h3>${esc(p.name)}</h3><small>${esc(p.duration)}</small><ul>${(p.steps||[]).map(x=>`<li>${esc(x)}</li>`).join('')}</ul></article>`).join('');
  const breakdown=Object.values(c.breakdown||{}),max=Math.max(1,...breakdown.map(x=>Number(x.maximum||0))),chart=breakdown.map(x=>`<div class="chart-row"><span>${esc(x.name)}</span><div><i style="width:${Math.max(2,Math.round(Number(x.maximum||0)/max*100))}%"></i></div><b>$${Number(x.maximum||0).toFixed(0)}</b></div>`).join('');
  const scenarios=(result.scenarios||[]).map(x=>`<article class="scenario-card ${esc(x.name)}"><div class="eyebrow">${esc(x.name)}</div><h3>${esc(x.title)}</h3><strong>$${Number(x.monthly_planning_cost||0).toFixed(2)} / mo</strong><p>${esc(x.availability_target)}</p><ul>${(x.rationale||[]).map(y=>`<li>${esc(y)}</li>`).join('')}</ul></article>`).join('');
  const risks=(result.architecture_risks||[]).map(r=>`<article class="optimization"><span class="pill ${r.severity==='high'?'danger':r.severity==='medium'?'draft':'info'}">${esc(r.severity)}</span><div><strong>${esc(r.title)}</strong><p>${esc(r.recommendation)}</p></div></article>`).join('');
  const pillars=(result.well_architected||[]).map(x=>`<article class="scenario-card"><div class="eyebrow">${esc(x.status)}</div><h3>${esc(x.pillar)}</h3><p>${esc(x.note)}</p></article>`).join('');
  const badges=(result.badges||[]).map(b=>`<div class="badge ${b.earned?'earned':''}"><strong>${esc(b.name)}</strong><small>${esc(b.description)}</small></div>`).join('');
  const opts=(result.optimization_suggestions||[]).map(o=>`<article class="optimization"><span class="pill ${esc(o.impact)}">${esc(o.impact)}</span><div><strong>${esc(o.title)}</strong><p>${esc(o.recommendation)}</p></div>${o.estimated_savings_percent!=null?`<b>~${Number(o.estimated_savings_percent).toFixed(0)}%</b>`:''}</article>`).join('');
  const adrs=(result.architecture_decisions||[]).map(d=>`<details><summary>${esc(d.id)} · ${esc(d.title)}</summary><p>${esc(d.decision)}</p><p class="hint"><strong>Alternatives:</strong> ${(d.alternatives||[]).map(esc).join(', ')}</p></details>`).join('');
  return `<section class="result-stack"><div class="result-hero panel"><div><div class="eyebrow">Recommended baseline · ${esc(a.classifier||'')}</div><h2>${esc(a.project_type)}</h2><p>Confidence <strong>${Math.round(a.confidence*100)}%</strong> · ${(a.detected_features||[]).length} detected features · ${esc(a.knowledge_version||'')}</p></div><div class="cost-badge"><small>Typical monthly planning</small><strong>${esc(c.summary.typical)}</strong><span>${esc(c.summary.minimum)} – ${esc(c.summary.maximum)}</span></div></div>${risks?`<section class="panel"><div class="panel-head"><h2>Architecture risks</h2><span>Explainable rule findings</span></div><div class="optimization-list">${risks}</div></section>`:'<section class="security-note"><strong>No high-signal rule fired</strong><p>This is not a security certification; validate service limits, threat model and recovery objectives before deployment.</p></section>'}${pillars?`<section class="panel"><div class="panel-head"><h2>Well-Architected review</h2><span>Six pillars</span></div><div class="scenario-grid">${pillars}</div></section>`:''}${scenarios?`<section class="panel"><div class="panel-head"><div><div class="eyebrow">Architecture choices</div><h2>Essential · Balanced · Resilient</h2></div><span>Immutable scenario basis</span></div><div class="scenario-grid">${scenarios}</div></section>`:''}<div class="result-grid"><section class="panel"><h2>Recommended services</h2><div class="service-list">${services}</div></section><section class="panel"><h2>Cost envelope</h2><div class="cost-three"><div><small>Minimum</small><strong>${esc(c.summary.minimum)}</strong></div><div><small>Typical</small><strong>${esc(c.summary.typical)}</strong></div><div><small>Maximum</small><strong>${esc(c.summary.maximum)}</strong></div></div><div class="cost-chart">${chart}</div><ul class="compact">${(c.assumptions||[]).map(x=>`<li>${esc(x)}</li>`).join('')}</ul></section></div>${badges?`<section class="panel"><div class="panel-head"><h2>Badges & learning feedback</h2><span>Derived, not security state</span></div><div class="badge-row">${badges}</div></section>`:''}${opts?`<section class="panel"><h2>Optimization suggestions</h2><div class="optimization-list">${opts}</div></section>`:''}<section class="panel"><div class="panel-head"><div><div class="eyebrow">Implementation</div><h2>${esc(g?.introduction?.title||'Implementation guide')}</h2></div><span>${esc(g?.introduction?.estimated_effort||'')}</span></div><p class="muted">${esc(g?.introduction?.overview||'')}</p><div class="phase-grid">${phases}</div>${adrs?`<div class="adr-list"><h3>Architecture Decision 